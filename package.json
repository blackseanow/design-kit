{
  "name": "design-kit",
  "version": "1.0.0",
  "private": true,
  "description": "Dev tooling for the design kit: browser checks, compatibility lint and accessibility scan. The kit itself has no build step.",
  "scripts": {
    "check": "node scripts/check.mjs",
    "browsers": "playwright install chromium webkit firefox",
    "test:js": "node --test tests/js/kit.test.js",
    "test:browser": "node tests/browser_check.js",
    "lint:compat": "node tests/compat_check.mjs && eslint design_kit/static",
    "lint:css": "node tests/compat_check.mjs",
    "lint:js": "eslint design_kit/static"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.0",
    "browserslist": "^4.24.0",
    "doiuse": "^6.0.0",
    "eslint": "^10.0.0",
    "eslint-plugin-compat": "^7.0.0",
    "playwright": "1.63.0",
    "postcss": "^8.5.0"
  }
}
